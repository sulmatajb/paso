{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": [
    "src",
    "app",
    "server",
    "db",
    "cloudflare-env.d.ts",
    "vite.config.ts",
    "build/sites-vite-plugin.ts"
  ]
}
